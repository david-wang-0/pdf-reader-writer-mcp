% ---- keys ------------------------------------------------------------------------------
% Our keys; every other key is a todonotes option and goes on to \todo.
\keys_define:nn { pdfnotes }
  {
    author    .tl_set:N   = \l__pdfnotes_author_tl ,
    color     .tl_set:N   = \l__pdfnotes_color_tl ,
    color     .initial:n  = orange ,
    kind      .tl_set:N   = \l__pdfnotes_kind_tl ,
    id        .tl_set:N   = \l__pdfnotes_id_tl ,
    replyto   .tl_set:N   = \l__pdfnotes_replyto_tl ,
    prefix    .tl_set:N   = \l__pdfnotes_prefix_tl ,
    icon      .tl_set:N   = \l__pdfnotes_icon_tl ,
    box       .bool_set:N = \l__pdfnotes_box_bool ,
    box       .initial:n  = true ,
    box       .default:n  = true ,
    style     .choices:nn =
      { highlight , underline , squiggly , strikeout }
      {
        \tl_set:Ne \l__pdfnotes_style_tl
          {
            \clist_item:nn { Highlight , Underline , Squiggly , StrikeOut }
              { \l_keys_choice_int }
          }
      } ,
    style     .initial:n  = highlight ,
    textcolor .tl_set:N   = \l__pdfnotes_textcolor_tl ,
    note      .bool_set:N = \l__pdfnotes_note_bool ,
    note      .initial:n  = true ,
    note      .default:n  = true ,
    notecolor .tl_set:N   = \l__pdfnotes_notecolor_tl ,
    todo      .code:n     = { \tl_put_right:Nn \l__pdfnotes_todo_tl { , #1 } } ,
    % marks: with the notes off, the marked text goes too (with the notes on, nothing
    % changes; not part of the id, not written to the PDF); \pdfnote ignores it
    remove    .bool_set:N = \l__pdfnotes_remove_bool ,
    remove    .initial:n  = false ,
    remove    .default:n  = true ,
  }

% Macro parameter characters (the # of color=#rrggbb) become ordinary characters, so a
% key list can go into a definition.
\cs_new_protected:Npn \__pdfnotes_safe:Nn #1#2
  {
    \tl_set:Nn #1 {#2}
    \regex_replace_all:nnN { \cP\# } { \cO\# } #1
  }

% Defaults for every later note and mark, e.g. \pdfnotesetup{author=Alice}.
\NewDocumentCommand \pdfnotesetup { m }
  {
    \__pdfnotes_safe:Nn \l__pdfnotes_tmp_tl {#1}
    \keys_set:nV { pdfnotes } \l__pdfnotes_tmp_tl
  }

\cs_new_protected:Npn \__pdfnotes_set:n #1
  {
    \tl_clear:N \l__pdfnotes_todo_tl
    \__pdfnotes_safe:Nn \l__pdfnotes_tmp_tl {#1}
    \keys_set_known:nVN { pdfnotes } \l__pdfnotes_tmp_tl \l__pdfnotes_unknown_tl
    \tl_if_empty:NF \l__pdfnotes_unknown_tl
      { \tl_put_left:Nn \l__pdfnotes_unknown_tl { , } }
    \__pdfnotes_color:
  }
\cs_generate_variant:Nn \keys_set_known:nnN { nV }
\cs_generate_variant:Nn \keys_set_known:nn { nV }
\cs_generate_variant:Nn \keys_set:nn { nV }
\cs_generate_variant:Nn \prop_gput:Nnn { NVn , NVV }
\cs_generate_variant:Nn \prop_get:NnNTF { NV }
\cs_generate_variant:Nn \prop_if_in:NnTF { NV }

% ---- switched off? ---------------------------------------------------------------------
\prg_new_conditional:Npnn \__pdfnotes_if_off: { TF , T , F , p }
  {
    \bool_lazy_or:nnTF
      { \g__pdfnotes_disable_bool }
      { \legacy_if_p:n { @todonotes@disabled } }
      { \prg_return_true: } { \prg_return_false: }
  }

% ---- colour ----------------------------------------------------------------------------
% \l__pdfnotes_xcolor_tl: a colour xcolor and todonotes understand; \l__pdfnotes_rgb_tl:
% `r g b' for /C, each component rounded to 4 decimal places. A palette name (the colours
% of pdf-reader-writer-mcp and the viewers: blue, yellow, green, orange, pink, purple,
% red, cyan, grey, gray; lower case) gives the palette's RGB, and the box the xcolor
% colour pdfnotes-<name> (xcolor's own blue, pink ... are left alone); color=#rrggbb gives
% rr/255, gg/255, bb/255 (and the xcolor colour pdfnotes-RRGGBB); any other value is an
% xcolor colour or expression, converted to RGB by xcolor.
\prop_const_from_keyval:Nn \c__pdfnotes_palette_prop
  {
    blue = { 0.6 ~ 0.8 ~ 1 } ,
    yellow = { 1 ~ 0.9 ~ 0.3 } ,
    green = { 0.6 ~ 0.9 ~ 0.6 } ,
    orange = { 1 ~ 0.7 ~ 0.4 } ,
    pink = { 1 ~ 0.7 ~ 0.85 } ,
    purple = { 0.8 ~ 0.7 ~ 1 } ,
    red = { 0.9 ~ 0.3 ~ 0.3 } ,
    cyan = { 0.55 ~ 0.95 ~ 0.95 } ,
    grey = { 0.75 ~ 0.75 ~ 0.75 } ,
    gray = { 0.75 ~ 0.75 ~ 0.75 } ,
  }
\prop_map_inline:Nn \c__pdfnotes_palette_prop
  {
    \tl_set:Nn \l__pdfnotes_tmp_tl {#2}
    \tl_replace_all:Nnn \l__pdfnotes_tmp_tl { ~ } { , }
    \exp_args:NnnV \definecolor { pdfnotes-#1 } { rgb } \l__pdfnotes_tmp_tl
  }
\cs_generate_variant:Nn \regex_extract_once:nnNTF { nV }
\cs_new_protected:Npn \__pdfnotes_color:
  {
    \prop_get:NVNTF \c__pdfnotes_palette_prop \l__pdfnotes_color_tl \l__pdfnotes_rgb_tl
      { \tl_set:Ne \l__pdfnotes_xcolor_tl { pdfnotes- \l__pdfnotes_color_tl } }
      { \__pdfnotes_color_other: }
  }
\cs_new_protected:Npn \__pdfnotes_color_other:
  {
    \regex_extract_once:nVNTF { \A \s* [\#] ([0-9A-Fa-f]{6}) \s* \Z }
      \l__pdfnotes_color_tl \l__pdfnotes_seq
      {
        \tl_set:Ne \l__pdfnotes_tmp_tl { \str_uppercase:f { \seq_item:Nn \l__pdfnotes_seq { 2 } } }
        \tl_set:Ne \l__pdfnotes_xcolor_tl { pdfnotes- \l__pdfnotes_tmp_tl }
        \exp_args:NV \__pdfnotes_define_html:nn \l__pdfnotes_xcolor_tl \l__pdfnotes_tmp_tl
        \tl_set:Ne \l__pdfnotes_rgb_tl
          {
            \__pdfnotes_hex_component:Vn \l__pdfnotes_tmp_tl { 1 } \c_space_tl
            \__pdfnotes_hex_component:Vn \l__pdfnotes_tmp_tl { 3 } \c_space_tl
            \__pdfnotes_hex_component:Vn \l__pdfnotes_tmp_tl { 5 }
          }
      }
      {
        \tl_set_eq:NN \l__pdfnotes_xcolor_tl \l__pdfnotes_color_tl
        \exp_args:NV \extractcolorspecs \l__pdfnotes_color_tl
          \l__pdfnotes_model_tl \l__pdfnotes_spec_tl
        \exp_args:NVV \convertcolorspec \l__pdfnotes_model_tl \l__pdfnotes_spec_tl
          { rgb } \l__pdfnotes_tmp_tl
        \tl_set:Ne \l__pdfnotes_rgb_tl
          {
            \exp_args:NV \clist_map_function:nN \l__pdfnotes_tmp_tl \__pdfnotes_rgb_item:n
          }
        \tl_trim_spaces:N \l__pdfnotes_rgb_tl
      }
  }
\cs_new_protected:Npn \__pdfnotes_define_html:nn #1#2
  { \xglobal \definecolor {#1} { HTML } {#2} }
\cs_new:Npn \__pdfnotes_hex_component:nn #1#2
  {
    \fp_eval:n
      { round ( \int_from_hex:e { \str_range:nnn {#1} {#2} { #2 + 1 } } / 255 , 4 ) }
  }
\cs_generate_variant:Nn \__pdfnotes_hex_component:nn { V }
\cs_generate_variant:Nn \int_from_hex:n { e }
\cs_new:Npn \__pdfnotes_rgb_item:n #1 { \fp_eval:n { round ( #1 , 4 ) } \c_space_tl }

% ---- the driver ------------------------------------------------------------------------
% \__pdfnotes_annot:nnnn {width bp} {height bp} {object} {dict}: an annotation whose /Rect
% spans from the current point `width' to the right and `height' up; the engine adds
% /Type and /Rect. {object} names the object reserved by \__pdfnotes_reserve:NN (or is
% empty). The dict must be fully expanded.
% \__pdfnotes_reserve:NN \obj \ref: reserve the object of an annotation still to come,
% \obj for \__pdfnotes_annot:nnnn, \ref to refer to it (/IRT).
\sys_if_engine_luatex:TF
  {
    \cs_new_protected:Npn \__pdfnotes_annot:nnnn #1#2#3#4
      {
        \pdfextension annot ~ #3 ~ width ~ #1 bp ~ height ~ #2 bp ~ depth ~ 0pt ~ {#4}
      }
    \cs_new_protected:Npn \__pdfnotes_reserve:NN #1#2
      {
        \pdfextension annot ~ reserveobjnum \scan_stop:
        \tl_set:Ne #1 { useobjnum ~ \int_eval:n { \pdffeedback lastannot } }
        \tl_set:Ne #2 { \int_eval:n { \pdffeedback lastannot } ~ 0 ~ R }
      }
    \cs_new_protected:Npn \__pdfnotes_info:n #1 { \pdfextension info {#1} }
  }
  {
    \sys_if_engine_xetex:TF
      {
        \cs_new_protected:Npn \__pdfnotes_annot:nnnn #1#2#3#4
          {
            \tex_special:D
              { pdf:ann ~ #3 ~ width ~ #1 bp ~ height ~ #2 bp ~ depth ~ 0bp ~ << #4 >> }
          }
        \cs_new_protected:Npn \__pdfnotes_reserve:NN #1#2
          {
            \int_gincr:N \g__pdfnotes_name_int
            \tl_set:Ne #1 { @pdfnotes \int_use:N \g__pdfnotes_name_int }
            \tl_set_eq:NN #2 #1
          }
        \cs_new_protected:Npn \__pdfnotes_info:n #1
          { \tex_special:D { pdf:docinfo ~ << #1 >> } }
      }
      {
        \cs_new_protected:Npn \__pdfnotes_annot:nnnn #1#2#3#4
          { \pdfannot ~ #3 ~ width ~ #1 bp ~ height ~ #2 bp ~ depth ~ 0pt ~ {#4} }
        \cs_new_protected:Npn \__pdfnotes_reserve:NN #1#2
          {
            \pdfannot ~ reserveobjnum \scan_stop:
            \tl_set:Ne #1 { useobjnum ~ \int_use:N \pdflastannot }
            \tl_set:Ne #2 { \int_use:N \pdflastannot \c_space_tl 0 ~ R }
          }
        \cs_new_protected:Npn \__pdfnotes_info:n #1 { \pdfinfo {#1} }
      }
  }

% PDF output? (Decided at \begin{document}, after any \pdfoutput setting.)
\AddToHook { begindocument / before }
  {
    \bool_lazy_or:nnTF
      { \sys_if_engine_xetex_p: }
      {
        ( \sys_if_engine_pdftex_p: || \sys_if_engine_luatex_p: )
        && \int_compare_p:nNn { \cs_if_exist_use:NF \tex_pdfoutput:D { 0 } } > { 0 }
      }
      { \bool_gset_true:N \g__pdfnotes_pdf_bool }
      {
        \bool_if:NF \g__pdfnotes_disable_bool
          {
            \PackageWarningNoLine { pdfnotes }
              { No~PDF~output~(DVI~mode?):~notes~are~typeset,~no~annotations }
          }
      }
  }

% With the first page: an invisible appearance (an empty 1bp form) for Text annotations
% over a todonotes box, so that viewers draw nothing of their own over it.
\AddToHook { begindocument } { \pdf_object_new:n { pdfnotes/empty } }
\AddToHook { shipout / firstpage }
  {
    \bool_lazy_and:nnT { \g__pdfnotes_pdf_bool } { ! \__pdfnotes_if_off_p: }
      {
        \pdf_object_write:nnn { pdfnotes/empty } { stream }
          { { /Type /XObject /Subtype /Form /BBox [ 0 ~ 0 ~ 1 ~ 1 ] /Resources << >> } { } }
      }
  }

% The document marker in the Info dictionary, when the notes are on: /PDFNotes (active)
% when every note and mark of this run got its annotation, /PDFNotes (pending) when one
% did not (positions not known yet: the first run with it, or a page that is gone).
% pdfTeX and LuaTeX: once, after the last page; XeTeX (xdvipdfmx reads it from a page,
% a later value replacing an earlier one): on every page.
\bool_new:N \g__pdfnotes_pending_bool
\seq_new:N \g__pdfnotes_queued_seq
\cs_new:Npn \__pdfnotes_state:
  { \bool_if:NTF \g__pdfnotes_pending_bool { pending } { active } }
\sys_if_engine_xetex:TF
  {
    \AddToHook { shipout / foreground }
      {
        \bool_lazy_and:nnT { \g__pdfnotes_pdf_bool } { ! \__pdfnotes_if_off_p: }
          { \put ( 0 , 0 ) { \__pdfnotes_info:n { /PDFNotes ~ ( \__pdfnotes_state: ) } } }
      }
  }
  {
    \AddToHook { enddocument / afterlastpage } { \__pdfnotes_info_end: }
  }
\cs_new_protected:Npn \__pdfnotes_info_end:
  {
    \bool_lazy_and:nnT { \g__pdfnotes_pdf_bool } { ! \__pdfnotes_if_off_p: }
      {
        % annotations queued for a page that was never shipped out
        \seq_map_inline:Nn \g__pdfnotes_queued_seq
          {
            \tl_if_empty:cF { g__pdfnotes_page_ ##1 _tl }
              { \bool_gset_true:N \g__pdfnotes_pending_bool }
          }
        \__pdfnotes_info:n { /PDFNotes ~ ( \__pdfnotes_state: ) }
      }
  }

% ---- strings ---------------------------------------------------------------------------
% \__pdfnotes_text:Nn \tl {text}: \tl is a UTF-16BE hex string <FEFF...> with the plain
% text of `text': LaTeX's \text_purify:n (markup goes, LICR such as \% or \'e becomes the
% character), escaped special characters as themselves, \\ and \newline a line feed,
% other commands dropped; runs of spaces become one, spaces next to a line feed and at
% either end go.
\text_declare_purify_equivalent:Nn \footnote { \use_none:n }
\text_declare_purify_equivalent:Nn \textcolor { \use_ii:nn }
\text_declare_purify_equivalent:Nn \textbackslash { \c_backslash_str }
\text_declare_purify_equivalent:Nn \textasciitilde { \char_generate:nn { 126 } { 12 } }
\text_declare_purify_equivalent:Nn \textasciicircum { \char_generate:nn { 94 } { 12 } }
\text_declare_purify_equivalent:Nn \\ { \char_generate:nn { 10 } { 12 } }
\text_declare_purify_equivalent:Nn \newline { \char_generate:nn { 10 } { 12 } }
\tl_const:Ne \c__pdfnotes_inenc_tl { \sys_if_engine_pdftex:T { utf8 } }
\cs_new_protected:Npn \__pdfnotes_text:Nn #1#2
  {
    \tl_set:Ne \l__pdfnotes_tmp_tl { \text_purify:n {#2} }
    \regex_replace_all:nnN { \cC. } { } \l__pdfnotes_tmp_tl
    \regex_replace_all:nnN { \x{20}+ } { \cO\  } \l__pdfnotes_tmp_tl
    \regex_replace_all:nnN { \x{20}* \x{0A} \x{20}* } { \x{0A} } \l__pdfnotes_tmp_tl
    \regex_replace_all:nnN { \A \x{20} | \x{20} \Z } { } \l__pdfnotes_tmp_tl
    \__pdfnotes_hex:NV #1 \l__pdfnotes_tmp_tl
  }
\cs_generate_variant:Nn \__pdfnotes_text:Nn { NV }
\cs_new_protected:Npn \__pdfnotes_hex:Nn #1#2
  {
    \str_set:Nn \l__pdfnotes_str {#2}
    \exp_args:NNVV \str_set_convert:NnnnTF \l__pdfnotes_str \l__pdfnotes_str
      \c__pdfnotes_inenc_tl { utf16/hex }
      { }
      {
        \str_set:Nn \l__pdfnotes_str {#2}
        \str_set_convert:NVnn \l__pdfnotes_str \l__pdfnotes_str { } { utf16/hex }
      }
    \tl_set:Ne #1 { < \l__pdfnotes_str > }
  }
\cs_generate_variant:Nn \__pdfnotes_hex:Nn { NV }
\cs_generate_variant:Nn \str_set_convert:Nnnn { NV }

% /NM (pdfnotes:<id>): a literal string when <id> is printable ASCII, else UTF-16 hex.
\cs_new_protected:Npn \__pdfnotes_name:NN #1#2
  {
    \str_set:Ne \l__pdfnotes_str { pdfnotes: #2 }
    \regex_match:nVTF { \A [\x{20}-\x{7E}]* \Z } \l__pdfnotes_str
      {
        \regex_replace_all:nnN { [\\\(\)] } { \\\0 } \l__pdfnotes_str
        \tl_set:Ne #1 { ( \l__pdfnotes_str ) }
      }
      { \__pdfnotes_hex:NV #1 \l__pdfnotes_str }
  }
\cs_generate_variant:Nn \regex_match:nnTF { nV }

\cs_new:Npn \__pdfnotes_two:n #1
  { \int_compare:nNnT {#1} < { 10 } { 0 } \int_eval:n {#1} }
\tl_const:Ne \c__pdfnotes_date_tl
  {
    ( D: \int_use:N \c_sys_year_int \__pdfnotes_two:n { \c_sys_month_int }
    \__pdfnotes_two:n { \c_sys_day_int } \__pdfnotes_two:n { \c_sys_hour_int }
    \__pdfnotes_two:n { \c_sys_minute_int } 00 )
  }

% ---- ids -------------------------------------------------------------------------------
% \l__pdfnotes_id_tl: the id= key, else the first 10 hex digits of the MD5 of
% `<type>|<author>|<kind>|<marked text>|<note>' (type `note' or `mark', the texts as
% written in the source, \detokenize'd). The second, third ... use of one id gets `-2',
% `-3' ... appended (in document order); a repeated explicit id also gets a warning.
\cs_new_protected:Npn \__pdfnotes_id:nnn #1#2#3   % type, marked text, note
  {
    \tl_if_empty:NTF \l__pdfnotes_id_tl
      {
        \str_set:Ne \l__pdfnotes_str
          {
            \str_mdfive_hash:e
              {
                #1 | \tl_to_str:V \l__pdfnotes_author_tl
                | \tl_to_str:V \l__pdfnotes_kind_tl
                | \tl_to_str:n {#2} | \tl_to_str:n {#3}
              }
          }
        \str_set:Ne \l__pdfnotes_str { \str_range:Nnn \l__pdfnotes_str { 1 } { 10 } }
        \tl_set:Ne \l__pdfnotes_id_tl { \str_lowercase:f { \l__pdfnotes_str } }
        \bool_set_false:N \l__pdfnotes_ok_bool
      }
      {
        \tl_set:Ne \l__pdfnotes_id_tl { \tl_to_str:V \l__pdfnotes_id_tl }
        \bool_set_true:N \l__pdfnotes_ok_bool
      }
    \prop_get:NVNTF \g__pdfnotes_ids_prop \l__pdfnotes_id_tl \l__pdfnotes_tmp_tl
      {
        \bool_if:NT \l__pdfnotes_ok_bool
          {
            \PackageWarning { pdfnotes }
              { id~`\l__pdfnotes_id_tl'~used~before;~this~one~gets~a~suffix }
          }
