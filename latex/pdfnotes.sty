%% pdfnotes.sty -- todonotes notes and marks that are also PDF annotations.
%%
%% A note typeset with todonotes is also a Text (sticky note) annotation, and a mark over
%% typeset text is also a Highlight, Underline, Squiggly or StrikeOut annotation carrying
%% the note, so every PDF viewer lists them (author, colour, note) and every tool that
%% reads annotations sees them. See README.md next to this file for the interface.
%%
%% Part of pdf-reader-writer-mcp (https://github.com/david-wang-0/pdf-reader-writer-mcp).
%% MIT License.
\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesExplPackage{pdfnotes}{2026-10-13}{0.1}
  {todonotes notes and marks that are also PDF annotations}

% ---- options ---------------------------------------------------------------------------
% disable: no notes and no annotations from this package (marks typeset their text
% plainly, or drop it with the remove key); also passed on to todonotes when that is not
% loaded yet. final: the same, but only as an option of this package (a class option
% `final', as IEEEtran and others take, does not switch the notes off).
\bool_new:N \g__pdfnotes_disable_bool
\DeclareOption { disable } { \bool_gset_true:N \g__pdfnotes_disable_bool }
\DeclareOption { final } { }
\DeclareOption*
  { \PackageWarning { pdfnotes } { Unknown~option~`\CurrentOption'~ignored } }
\ProcessOptions \scan_stop:
\@ifpackagewith { pdfnotes } { final }
  { \bool_gset_true:N \g__pdfnotes_disable_bool } { }

\@ifpackageloaded { todonotes } { }
  {
    \bool_if:NT \g__pdfnotes_disable_bool
      { \PassOptionsToPackage { disable } { todonotes } }
  }
\RequirePackage { todonotes }
\RequirePackage { xcolor }
\RequirePackage { zref-savepos }
\RequirePackage { zref-abspage }

% Width and line height inside a todonotes box, recorded with the note's start position.
\zref@newprop { pdfnoteswd } [ 0 ] { \number \linewidth }
\zref@newprop { pdfnotesht } [ 0 ] { \number \ht \strutbox }
\zref@newprop { pdfnotesdp } [ 0 ] { \number \dp \strutbox }

