        { \fp_eval:n { \__pdfnotes_bp:nn {#1} { posy } } }
        { \__pdfnotes_page:n {#1} }
      }
  }
\cs_generate_variant:Nn \__pdfnotes_point:n { e }
\cs_new_protected:Npn \__pdfnotes_mark_metrics:
  {
    \fp_set:Nn \l__pdfnotes_bs_fp { \dim_to_decimal_in_bp:n { \baselineskip } }
    \fp_compare:nNnT \l__pdfnotes_bs_fp < { 1 }
      { \fp_set:Nn \l__pdfnotes_bs_fp { \dim_to_decimal_in_bp:n { 1.2 \f@size pt } } }
    \fp_set:Nn \l__pdfnotes_asc_fp
      { \dim_to_decimal_in_bp:n { \tex_fontcharht:D \tex_font:D `( } }
    \fp_set:Nn \l__pdfnotes_dsc_fp
      { \dim_to_decimal_in_bp:n { \tex_fontchardp:D \tex_font:D `( } }
    \fp_compare:nNnT { \l__pdfnotes_asc_fp + \l__pdfnotes_dsc_fp } < { 1 }
      {
        \fp_set:Nn \l__pdfnotes_asc_fp { 0.75 * \l__pdfnotes_bs_fp }
        \fp_set:Nn \l__pdfnotes_dsc_fp { 0.25 * \l__pdfnotes_bs_fp }
      }
    \fp_set:Nn \l__pdfnotes_lm_fp { \dim_to_decimal_in_bp:n { \@totalleftmargin } }
    \fp_set:Nn \l__pdfnotes_lw_fp { \dim_to_decimal_in_bp:n { \linewidth } }
    \fp_set:Nn \l__pdfnotes_xe_fp { \__pdfnotes_bp:nn { \l__pdfnotes_label_tl .e } { posx } }
    \zref@ifrefundefined { \l__pdfnotes_label_tl .sl }
      {
        % no \vadjust (inside a box): the mark is on one line
        \fp_set:Nn \l__pdfnotes_Ls_fp
          {
            min ( \__pdfnotes_bp:nn { \l__pdfnotes_label_tl .s } { posx } ,
              \l__pdfnotes_xe_fp ) - \l__pdfnotes_lm_fp
          }
      }
      {
        \fp_set:Nn \l__pdfnotes_Ls_fp
          { \__pdfnotes_bp:nn { \l__pdfnotes_label_tl .sl } { posx } }
      }
    \zref@ifrefundefined { \l__pdfnotes_label_tl .el }
      { \fp_set_eq:NN \l__pdfnotes_Le_fp \l__pdfnotes_Ls_fp }
      {
        \fp_set:Nn \l__pdfnotes_Le_fp
          { \__pdfnotes_bp:nn { \l__pdfnotes_label_tl .el } { posx } }
      }
  }
% One point {x}{y}{page}: on the current line, or the start of the next.
\cs_new_protected:Npn \__pdfnotes_mark_point:n #1 { \__pdfnotes_mark_point:nnn #1 }
\cs_new_protected:Npn \__pdfnotes_mark_point:nnn #1#2#3
  {
    \int_compare:nNnTF \l__pdfnotes_runs_int = 0
      { \__pdfnotes_run_start:nnn {#1} {#2} {#3} }
      {
        \bool_lazy_and:nnTF
          { \int_compare_p:nNn {#3} = \l__pdfnotes_rpage_int }
          {
            \fp_compare_p:nNn
              { abs ( #2 - \l__pdfnotes_ry_fp ) } < { 0.3 * \l__pdfnotes_bs_fp }
          }
          {
            \fp_set:Nn \l__pdfnotes_rx_fp { min ( \l__pdfnotes_rx_fp , #1 ) }
            \fp_set:Nn \l__pdfnotes_rX_fp { max ( \l__pdfnotes_rX_fp , #1 ) }
          }
          {
            \__pdfnotes_run_flush:n { false }
            % a new page, or up the page (the next column): the end's column from here
            \bool_lazy_or:nnT
              { ! \int_compare_p:nNn {#3} = \l__pdfnotes_rpage_int }
              { \fp_compare_p:nNn {#2} > \l__pdfnotes_ry_fp }
              { \bool_set_true:N \l__pdfnotes_ecol_bool }
            % lines with no point of their own between this one and the last
            \bool_lazy_all:nT
              {
                { \int_compare_p:nNn {#3} = \l__pdfnotes_rpage_int }
                { \fp_compare_p:nNn { \l__pdfnotes_ry_fp - #2 } > { 1.5 * \l__pdfnotes_bs_fp } }
              }
              {
                \int_set:Nn \l__pdfnotes_m_int
                  { \fp_eval:n { round ( ( \l__pdfnotes_ry_fp - #2 ) / \l__pdfnotes_bs_fp ) } }
                \int_step_inline:nn { \l__pdfnotes_m_int - 1 }
                  {
                    \__pdfnotes_line:nnnn {#3}
                      { \l__pdfnotes_ry_fp - ##1 * ( \l__pdfnotes_ry_fp - #2 ) / \l__pdfnotes_m_int }
                      { \__pdfnotes_col_left: }
                      { \__pdfnotes_col_left: + \l__pdfnotes_lw_fp }
                  }
              }
            \__pdfnotes_run_start:nnn {#1} {#2} {#3}
          }
      }
  }
\cs_new_protected:Npn \__pdfnotes_run_start:nnn #1#2#3
  {
    \int_incr:N \l__pdfnotes_runs_int
    \int_set:Nn \l__pdfnotes_rpage_int {#3}
    \fp_set:Nn \l__pdfnotes_ry_fp {#2}
    \fp_set:Nn \l__pdfnotes_rx_fp {#1}
    \fp_set:Nn \l__pdfnotes_rX_fp {#1}
  }
\cs_new:Npn \__pdfnotes_col_left:
  {
    ( \bool_if:NTF \l__pdfnotes_ecol_bool { \l__pdfnotes_Le_fp } { \l__pdfnotes_Ls_fp }
      + \l__pdfnotes_lm_fp )
  }
% Close the current line; #1: is it the last?
\cs_new_protected:Npn \__pdfnotes_run_flush:n #1
  {
    \__pdfnotes_line:nnnn { \l__pdfnotes_rpage_int } { \l__pdfnotes_ry_fp }
      {
        \int_compare:nNnTF \l__pdfnotes_runs_int = 1
          { \l__pdfnotes_rx_fp }
          { min ( \l__pdfnotes_rx_fp , \__pdfnotes_col_left: ) }
      }
      {
        \str_if_eq:nnTF {#1} { true }
          { \l__pdfnotes_xe_fp }
          { max ( \l__pdfnotes_rX_fp , \__pdfnotes_col_left: + \l__pdfnotes_lw_fp ) }
      }
  }
% \__pdfnotes_line:nnnn {page} {baseline} {x1} {x2}: one quad (upper left, upper right,
% lower left, lower right, as Acrobat writes them) on that page, fp expressions in bp.
\cs_new_protected:Npn \__pdfnotes_line:nnnn #1#2#3#4
  {
    \tl_set:Ne \l__pdfnotes_tmp_tl { \int_eval:n {#1} }
    \seq_if_in:NVF \l__pdfnotes_pages_seq \l__pdfnotes_tmp_tl
      {
        \seq_put_right:NV \l__pdfnotes_pages_seq \l__pdfnotes_tmp_tl
        \tl_clear_new:c { l__pdfnotes_q_ \l__pdfnotes_tmp_tl _tl }
        \clist_map_inline:nn { x , y , X , Y }
          { \fp_zero_new:c { l__pdfnotes_ ##1 _ \l__pdfnotes_tmp_tl _fp } }
        \fp_set:cn { l__pdfnotes_x_ \l__pdfnotes_tmp_tl _fp } { inf }
        \fp_set:cn { l__pdfnotes_y_ \l__pdfnotes_tmp_tl _fp } { inf }
        \fp_set:cn { l__pdfnotes_X_ \l__pdfnotes_tmp_tl _fp } { -inf }
        \fp_set:cn { l__pdfnotes_Y_ \l__pdfnotes_tmp_tl _fp } { -inf }
      }
    \fp_set:Nn \l__pdfnotes_y_fp {#2}
    \fp_set:Nn \l__pdfnotes_x_fp { min ( #3 , #4 ) }
    \fp_set:Nn \l__pdfnotes_w_fp { max ( #3 , #4 ) }
    \tl_put_right:ce { l__pdfnotes_q_ \l__pdfnotes_tmp_tl _tl }
      {
        \__pdfnotes_num:n { \l__pdfnotes_x_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_y_fp + \l__pdfnotes_asc_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_w_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_y_fp + \l__pdfnotes_asc_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_x_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_y_fp - \l__pdfnotes_dsc_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_w_fp } ~
        \__pdfnotes_num:n { \l__pdfnotes_y_fp - \l__pdfnotes_dsc_fp } ~
      }
    \__pdfnotes_bbox:nnn { x } { min } { \l__pdfnotes_x_fp }
    \__pdfnotes_bbox:nnn { X } { max } { \l__pdfnotes_w_fp }
    \__pdfnotes_bbox:nnn { y } { min } { \l__pdfnotes_y_fp - \l__pdfnotes_dsc_fp }
    \__pdfnotes_bbox:nnn { Y } { max } { \l__pdfnotes_y_fp + \l__pdfnotes_asc_fp }
  }
\cs_new_protected:Npn \__pdfnotes_bbox:nnn #1#2#3
  {
    \fp_set:cn { l__pdfnotes_ #1 _ \l__pdfnotes_tmp_tl _fp }
      { #2 ( \use:c { l__pdfnotes_ #1 _ \l__pdfnotes_tmp_tl _fp } , #3 ) }
  }
\cs_generate_variant:Nn \seq_if_in:NnF { NV }
% One annotation per page; the first is the one replies refer to.
\cs_new_protected:Npn \__pdfnotes_mark_queue:
  {
    \bool_set_true:N \l__pdfnotes_ok_bool
    \seq_map_inline:Nn \l__pdfnotes_pages_seq
      {
        \__pdfnotes_need:nT { pdfnotes.p ##1 }
          {
            \bool_if:NTF \l__pdfnotes_ok_bool
              { \__pdfnotes_reserve: \bool_set_false:N \l__pdfnotes_ok_bool }
              { \tl_clear:N \l__pdfnotes_obj_tl }
            \__pdfnotes_queue:nnnnnnn {##1}
              { \use:c { l__pdfnotes_x_ ##1 _fp } }
              { \use:c { l__pdfnotes_y_ ##1 _fp } }
              { \use:c { l__pdfnotes_X_ ##1 _fp } - \use:c { l__pdfnotes_x_ ##1 _fp } }
              { \use:c { l__pdfnotes_Y_ ##1 _fp } - \use:c { l__pdfnotes_y_ ##1 _fp } }
              { \l__pdfnotes_obj_tl }
              {
                /Subtype / \l__pdfnotes_style_tl \c_space_tl
                /QuadPoints ~ [ \tl_use:c { l__pdfnotes_q_ ##1 _tl } ] ~
                \l__pdfnotes_common_tl
              }
          }
      }
  }
